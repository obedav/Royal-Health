# Production Environment Variables for Royal Health Frontend
# These are safe to include in the frontend build

# Database Configuration - No longer using Supabase
# Using direct API backend configuration below

# API Configuration - Correct URL for PHP backend
VITE_API_BASE_URL=https://royalhealthconsult.com/api/v1
VITE_WS_URL=wss://royal-health.onrender.com

# Application Settings
VITE_APP_NAME="Royal Health Consult"
VITE_APP_VERSION="1.0.0"
VITE_APP_ENV=production

# Feature Flags
VITE_ENABLE_PWA=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_ANALYTICS=true

# Analytics — set real IDs in the Vercel dashboard (Project > Settings > Environment Variables)
# VITE_GA_ID=
# VITE_GTM_ID=
# VITE_HOTJAR_ID=
# VITE_SENTRY_DSN=

# Contact Information
VITE_SUPPORT_EMAIL=care@royalhealthconsult.com
VITE_SUPPORT_PHONE=+2347063325184
VITE_COMPANY_ADDRESS="Lagos, Nigeria"

# SEO
VITE_DEFAULT_TITLE="Royal Health Consult - Professional Healthcare at Home"
VITE_DEFAULT_DESCRIPTION="Book qualified healthcare professionals for home care services across Nigeria. Safe, reliable, and professional healthcare when you need it most."